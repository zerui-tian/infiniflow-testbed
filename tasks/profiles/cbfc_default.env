# Shared profile for cbfc experiment pipeline.
# Orchestration variables are used by tasks/pipelines/*.sh.
# Role-specific variables are used by tasks/hosts/*/*.sh.

# ---------------------------
# Orchestration
# ---------------------------
ORCH_SWITCH_HOST="B06-4_server4_ns3_server"
ORCH_SENDERS="server2,server3"
ORCH_RECEIVERS="server1"
ORCH_REMOTE_REPO_DIR="~/infiniflow-testbed"
ORCH_SWITCH_WARMUP_SEC="2"
ORCH_RECEIVER_WARMUP_SEC="2"
ORCH_RUN_SYNC="1"
ORCH_SENDER_SCRIPT="tasks/hosts/server3/sender.sh"
ORCH_RECEIVER_SCRIPT="tasks/hosts/server2/receiver.sh"
ORCH_SWITCH_SCRIPT="tasks/hosts/server4/switch.sh"

# ---------------------------
# Sender instances
# ---------------------------
# sender on server2
SENDER_SERVER2_HOST="B03_tmp2_server2"
SENDER_SERVER2_EAL_LCORES="1-4"
SENDER_SERVER2_EAL_MEM_CHANNELS="4"
SENDER_SERVER2_EAL_PCI_ADDR="0000:42:00.1"
SENDER_SERVER2_LOG_LEVEL="DEBUG"
SENDER_SERVER2_CSV_FILE="examples/cbfc_test.csv"
SENDER_SERVER2_PORT_ID="0"
SENDER_SERVER2_NB_VC="1"
SENDER_SERVER2_RING_SIZE="1024"
SENDER_SERVER2_PKT_SIZE="1500"
SENDER_SERVER2_MEMPOOL_SIZE="32768"
SENDER_SERVER2_TX_BURST="64"
SENDER_SERVER2_RX_BURST="64"
SENDER_SERVER2_TICK_US="1"
SENDER_SERVER2_FC_MODE="cbfc"
SENDER_SERVER2_INITIAL_FCCL="1"

# sender on server3
# NOTE: update host alias to your real server3 SSH host if needed.
SENDER_SERVER3_HOST="B06-3_server5"
SENDER_SERVER3_EAL_LCORES="1-4"
SENDER_SERVER3_EAL_MEM_CHANNELS="4"
SENDER_SERVER3_EAL_PCI_ADDR="0000:42:00.1"
SENDER_SERVER3_LOG_LEVEL="DEBUG"
SENDER_SERVER3_CSV_FILE="examples/cbfc_test.csv"
SENDER_SERVER3_PORT_ID="0"
SENDER_SERVER3_NB_VC="1"
SENDER_SERVER3_RING_SIZE="1024"
SENDER_SERVER3_PKT_SIZE="1500"
SENDER_SERVER3_MEMPOOL_SIZE="32768"
SENDER_SERVER3_TX_BURST="64"
SENDER_SERVER3_RX_BURST="64"
SENDER_SERVER3_TICK_US="1"
SENDER_SERVER3_FC_MODE="cbfc"
SENDER_SERVER3_INITIAL_FCCL="1"

# ---------------------------
# Receiver instances
# ---------------------------
RECEIVER_SERVER1_HOST="B03_tmp3_server1"
RECEIVER_SERVER1_EAL_LCORES="5"
RECEIVER_SERVER1_EAL_MEM_CHANNELS="4"
RECEIVER_SERVER1_EAL_PCI_ADDR="0000:01:00.1"
RECEIVER_SERVER1_LOG_LEVEL="DEBUG"
RECEIVER_SERVER1_PORT_ID="0"
RECEIVER_SERVER1_NB_VC="1"
RECEIVER_SERVER1_RX_BURST="64"
RECEIVER_SERVER1_TX_BURST="64"
RECEIVER_SERVER1_PKT_SIZE="1500"
RECEIVER_SERVER1_MEMPOOL_SIZE="32768"
RECEIVER_SERVER1_FC_MODE="cbfc"
RECEIVER_SERVER1_CBFC_BUFFER_PKTS="2"
RECEIVER_SERVER1_OUTPUT_FILE="output/cbfc_test_receiver_server1.csv"

# ---------------------------
# Switch defaults
# ---------------------------
SWITCH_EAL_LCORES="1-8"
SWITCH_EAL_MEM_CHANNELS="4"
SWITCH_EAL_PCI_ADDRS=""
SWITCH_LOG_LEVEL="DEBUG"
SWITCH_INGRESS_PORTS="0,1"
SWITCH_EGRESS_PORT="2"
