# Shared profile for cbfc experiment pipeline.
# Orchestration variables are used by tasks/pipelines/*.sh.
# Role-specific variables are used by tasks/hosts/*/*.sh.

# ---------------------------
# Orchestration
# ---------------------------
ORCH_HOST_SWITCH="B06-4_server4_ns3_server"
ORCH_HOST_RECEIVER="B03_tmp2_server2"
ORCH_HOST_SENDER="B03_tmp3_server1"
ORCH_REMOTE_REPO_DIR="~/infiniflow-testbed"
ORCH_SWITCH_WARMUP_SEC="2"
ORCH_RECEIVER_WARMUP_SEC="2"
ORCH_RUN_SYNC="1"

# ---------------------------
# Sender defaults
# ---------------------------
SENDER_EAL_LCORES="1-4"
SENDER_EAL_MEM_CHANNELS="4"
SENDER_EAL_PCI_ADDR="0000:42:00.1"
SENDER_LOG_LEVEL="DEBUG"
SENDER_CSV_FILE="examples/cbfc_test.csv"
SENDER_PORT_ID="0"
SENDER_NB_VC="1"
SENDER_RING_SIZE="1024"
SENDER_PKT_SIZE="1500"
SENDER_MEMPOOL_SIZE="32768"
SENDER_TX_BURST="64"
SENDER_RX_BURST="64"
SENDER_TICK_US="1"
SENDER_FC_MODE="cbfc"
SENDER_INITIAL_FCCL="1"

# ---------------------------
# Receiver defaults
# ---------------------------
RECEIVER_EAL_LCORES="5"
RECEIVER_EAL_MEM_CHANNELS="4"
RECEIVER_EAL_PCI_ADDR="0000:01:00.1"
RECEIVER_LOG_LEVEL="DEBUG"
RECEIVER_PORT_ID="0"
RECEIVER_NB_VC="1"
RECEIVER_RX_BURST="64"
RECEIVER_TX_BURST="64"
RECEIVER_PKT_SIZE="1500"
RECEIVER_MEMPOOL_SIZE="32768"
RECEIVER_FC_MODE="cbfc"
RECEIVER_CBFC_BUFFER_PKTS="2"
RECEIVER_OUTPUT_FILE="output/cbfc_test_receiver.csv"

# ---------------------------
# Switch defaults
# ---------------------------
SWITCH_EAL_LCORES="1-8"
SWITCH_EAL_MEM_CHANNELS="4"
SWITCH_EAL_PCI_ADDRS=""
SWITCH_LOG_LEVEL="DEBUG"
SWITCH_INGRESS_PORTS="0,1"
SWITCH_EGRESS_PORT="2"
SWITCH_NB_VC="8"
SWITCH_VC_RING_SIZE="1024"
SWITCH_FEEDBACK_RING_SIZE="1024"
SWITCH_PKT_SIZE="1500"
SWITCH_MEMPOOL_SIZE="32768"
SWITCH_TX_BURST="64"
SWITCH_RX_BURST="64"
SWITCH_FC_MODE="cbfc"
SWITCH_INITIAL_FCCL="1024"
SWITCH_VC_CAPACITY="1024"
SWITCH_FLOW_MAP_SPEC=""
